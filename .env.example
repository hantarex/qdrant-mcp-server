COMPOSE_PROJECT_NAME=qdrant-mcp

# Host ports exposed for local checks and optional direct access.
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
OLLAMA_HOST_PORT=11434
MCP_HOST_PORT=3000
REDIS_HOST_PORT=6379

# Internal docker-compose service URLs.
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434

# Collection and embedding model.
QDRANT_COLLECTION=front-codebase
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://ollama:11434

# Optional Qdrant API key for secured instances. Leave empty for local Qdrant.
QDRANT_API_KEY=

# MCP server behavior.
LOG_LEVEL=info

# Upstream ready-made MCP server source.
QDRANT_MCP_REPO=https://github.com/mhalder/qdrant-mcp-server.git
QDRANT_MCP_REF=v3.3.5

# Redis service used by the official stdio Redis MCP server.
REDIS_IMAGE=redis:8.10.1-alpine

# Default project mounted read-only into the MCP container.
FRONT_PROJECT_PATH=/home/sham/PhpstormProjects/front
